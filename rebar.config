%% rebar.config — substrate-L0 Erlang project
%%
%% Phase A / Workstream 1 / Relay 2 — `ra` integration + Spine state machine
%% DOE 2026-06-02 per EA RFI rulings (forum-review 1432 R)
%%
%% `ra` version pin: v3.1.7 (LTS-pinned per EA Ruling 1; most-recent stable;
%% v3.x line has 8 releases over ~3 months — mature; published 2026-05-11)

{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{deps, [
    {ra, "3.1.7"}
]}.

{minimum_otp_vsn, "27"}.

{relx, [
    {release, {substrate_l0, "0.1.0"}, [
        spine,
        ra,
        sasl
    ]},
    {sys_config, "./config/sys.config"},
    {include_erts, false},
    {extended_start_script, true},
    {generate_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true},
            {include_src, false}
        ]}
    ]}
]}.

{shell, [
    {apps, [spine]}
]}.
